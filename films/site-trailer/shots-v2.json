      "init": "(()=>{for(const C of [window.WebGL2RenderingContext,window.WebGLRenderingContext]){if(!C)continue;const P=C.prototype;const g=P.getUniformLocation;P.getUniformLocation=function(p,n){const l=g.call(this,p,n);if(l&&n==='spoon')l.__spoon=1;return l};const u=P.uniform3f;P.uniform3f=function(l,x,y,z){return u.call(this,l,x,y,l&&l.__spoon?0:z)}}})()",
