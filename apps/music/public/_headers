/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self' https://music-cdn.shapeof.world https://cloudflareinsights.com; font-src 'self' data:; form-action 'none'; frame-ancestors 'none'; img-src 'self' data: https://shapeof.world; media-src 'self' blob: https://music-cdn.shapeof.world; object-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; upgrade-insecure-requests

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/catalog.json
  Access-Control-Allow-Origin: *

/catalog.ndjson
  Access-Control-Allow-Origin: *

/taxonomy.json
  Access-Control-Allow-Origin: *

/styles/*
  Access-Control-Allow-Origin: *

/scenarios/*
  Access-Control-Allow-Origin: *

/tracks/*
  Access-Control-Allow-Origin: *

/llms.txt
  Access-Control-Allow-Origin: *

/audio-index.json
  Access-Control-Allow-Origin: *

/audio/*
  Access-Control-Allow-Origin: *

/rights.json
  Access-Control-Allow-Origin: *

/audio-license.txt
  Access-Control-Allow-Origin: *

/packs.json
  Access-Control-Allow-Origin: *

/collections/*
  Access-Control-Allow-Origin: *
