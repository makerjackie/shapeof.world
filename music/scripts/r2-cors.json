{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://music.shapeof.world",
          "https://shapeof.world",
          "http://localhost:5180"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range", "Accept-Ranges"],
      "maxAgeSeconds": 86400
    }
  ]
}
