# Static assets are served directly by Cloudflare and never pass through the
# Worker, so the security headers set in `src/routes/__root.tsx` do not reach
# them. Keep the universally safe ones here.
#
# Do NOT add `X-Frame-Options` or a `frame-ancestors` directive to `/*`: worlds
# embed same-origin vendor documents (`/vendor/ai-world/`,
# `/vendor/black-hole/demo.html`, `/vendor/periodic-table/`) in an iframe, and
# those documents must stay frameable.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# `/offline` is the service worker's offline fallback and the only static asset
# browsers render as a top-level document, so it gets the full document policy.
# It contains one inline `<style>` block, no scripts and no images.
/offline
  Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; style-src 'unsafe-inline'
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Vite emits content-hashed JavaScript, CSS and font filenames. These files are
# safe to keep in the browser cache permanently; poster URLs stay mutable.
/assets/*.js
  Cache-Control: public, max-age=31556952, immutable

/assets/*.css
  Cache-Control: public, max-age=31556952, immutable

/assets/*.woff
  Cache-Control: public, max-age=31556952, immutable

/assets/*.woff2
  Cache-Control: public, max-age=31556952, immutable

/generated/world-artifacts/*
  Cache-Control: public, max-age=60, stale-while-revalidate=300

# Pinned flybody replay version and content-addressed real photograph.
/assets/worlds/flybody/replay/v1/*
  Cache-Control: public, max-age=31536000, immutable

/assets/worlds/flybody/real-fly-451fa4816052.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/worlds/flybody/fly-render-404267a77b19.webp
  Cache-Control: public, max-age=31536000, immutable
