{
  "name": "shape-of-the-world",
  "version": "0.1.0",
  "description": "Shape of the World \u2014 the worlds hidden inside our world.",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm data:world-artifacts && vite",
    "build:periodic-table": "npm install --prefix vendor/three-periodic-table --package-lock=false && ONEWORLD_OUT_DIR=$PWD/public/vendor/periodic-table npm run build --prefix vendor/three-periodic-table",
    "data:world-music": "node scripts/generate-world-music.mjs && node scripts/generate-world-soundtrack.mjs",
    "data:world-summaries": "node scripts/generate-world-summaries.mjs",
    "data:world-artifacts": "pnpm data:world-summaries && node scripts/generate-world-artifacts.mjs",
    "i18n:experiences": "node scripts/generate-experience-dictionaries.mjs",
    "posters:mobile": "node scripts/generate-mobile-posters.mjs",
    "posters:desktop": "node scripts/generate-desktop-posters.mjs",
    "posters:thumb": "node scripts/generate-thumb-posters.mjs",
    "posters:orb": "ONEWORLD_POSTER_KIND=orb node scripts/generate-thumb-posters.mjs",
    "posters:social": "node scripts/generate-social-cards.mjs",
    "analytics:weekly": "node scripts/analytics-weekly.mjs",
    "campaign:url": "node scripts/campaign-url.mjs",
    "build": "pnpm build:prepare && vite build && pnpm typecheck",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:infra": "pnpm --dir infra/oneworld-redirector test && pnpm --dir infra/shapeofworld-v1 test && pnpm --dir infra/insights test && pnpm --dir infra/press test",
    "client:bundle-check": "node scripts/check-client-assets.mjs",
    "audit:shape": "node scripts/audit-world-shape.mjs",
    "audit:mobile": "node scripts/audit-mobile-shell.mjs",
    "audit:perf": "node scripts/audit-world-perf.mjs",
    "audit:seo-p0": "node scripts/audit-seo-p0-pages.mjs",
    "audit:smoke": "node scripts/smoke-worlds.mjs",
    "audit:deps": "pnpm --registry=https://registry.npmjs.org audit --prod",
    "check:scripts": "node --test scripts/audit-seo-p0-pages.test.mjs scripts/world-audit-selection.test.mjs scripts/check-plan.test.mjs",
    "check:world": "pnpm exec vitest run src/data/worlds/experience-policy.test.ts src/lib/experience-capabilities.test.ts src/lib/motion.test.ts src/lib/next-world.test.ts src/lib/world-playback.test.ts src/components/experience-shell-policy.test.ts",
    "world:check": "node scripts/check-world.mjs",
    "music:dev": "pnpm --dir apps/music dev",
    "music:build": "pnpm --dir apps/music build",
    "music:deploy": "pnpm --dir apps/music deploy",
    "music:typecheck": "pnpm --dir apps/music typecheck",
    "worker:bundle-check": "node scripts/check-worker-bundle.mjs",
    "check": "node scripts/check.mjs",
    "smoke:production": "node scripts/smoke-production.mjs --base https://new.shapeof.world",
    "cf-typegen": "wrangler types",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url cookie preferredLanguage baseLocale --output-structure message-modules",
    "postinstall": "pnpm paraglide:compile && WRANGLER_LOG=warn pnpm --silent cf-typegen",
    "build:prepare": "node scripts/generate-route-reservations.mjs && pnpm data:world-music && pnpm data:world-artifacts && node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "@allmaps/maplibre": "1.0.0-beta.43",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@deck.gl/core": "9.3.6",
    "@deck.gl/layers": "9.3.6",
    "@deck.gl/react": "9.3.6",
    "@dgreenheck/three-pinata": "^2.0.1",
    "@flowmap.gl/layers": "9.4.0",
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@google/model-viewer": "4.3.1",
    "@inlang/paraglide-js": "^2.25.0",
    "@niivue/niivue": "0.69.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "3.0.4",
    "@takram/three-atmosphere": "^0.19.1",
    "@takram/three-geospatial": "^0.9.1",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "astronomy-engine": "2.1.19",
    "better-auth": "1.7.5",
    "d3-geo": "3.1.1",
    "d3-hierarchy": "^3.1.2",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.2",
    "maplibre-gl": "5.24.0",
    "matter-js": "^0.20.0",
    "openseadragon": "6.0.2",
    "postprocessing": "^6.39.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "satellite.js": "6.0.2",
    "swiper": "^12.2.0",
    "three": "^0.183.0",
    "uqr": "0.1.2",
    "web-vitals": "6.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.29.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/d3-geo": "3.1.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/geojson": "^7946.0.16",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vitest": "^3.2.4",
    "wrangler": "^4.110.0"
  }
}
