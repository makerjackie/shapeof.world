{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shape-of-the-world",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.ts",
  "assets": {
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "routes": [
    { "pattern": "shapeof.world", "custom_domain": true },
    { "pattern": "new.shapeof.world", "custom_domain": true },
    { "pattern": "open.shapeof.world", "custom_domain": true },
    { "pattern": "v2.shapeof.world", "custom_domain": true }
  ],
  // The archived earlier site, served at v2.shapeof.world (see src/server.ts).
  // Large world files (car models, HDRs, decoders) under /assets/<world>/v<n>/, see src/worker/world-assets.ts.
  "r2_buckets": [
    { "binding": "WORLD_ASSETS", "bucket_name": "shapeof-world-assets" }
  ],
  "services": [
    { "binding": "LEGACY", "service": "oneworld" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  },
  "ratelimits": [
    {
      "name": "EVENT_RATE_LIMITER",
      "namespace_id": "31001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "31003",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "OW_ANALYTICS",
      "dataset": "oneworld_events"
    }
  ],
  "send_email": [
    {
      "name": "FEEDBACK_EMAIL",
      "destination_address": "contact@01mvp.com",
      "allowed_sender_addresses": [
        "feedback@shapeof.world"
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FEEDBACK_DELIVERY",
        "class_name": "FeedbackDelivery"
      }
    ]
  },
  "migrations": [
    {
      "tag": "feedback-delivery-v1",
      "new_sqlite_classes": [
        "FeedbackDelivery"
      ]
    }
  ]
}
